# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep example env
!.env.example
.vercel
.env*

# review8 게이트 로컬 마커 (워킹트리 상태 해시 — 커밋 금지)
.claude/.review8-hash

# playwright MCP 아티팩트 (콘솔·페이지 스냅샷 로그)
.playwright-mcp/

# 구 널스넷 이관 원천 데이터 — 개인정보(이름·휴대폰·이메일)·사업자번호가 들어 있어 절대 커밋하지 않는다.
# 이관 스크립트는 1회성이며, 다시 돌릴 일이 있으면 phpMyAdmin에서 새로 뽑는다.
/resumes_legacy_*.json
/scripts/legacy-data/*
!/scripts/legacy-data/bhjob_codes.json
!/scripts/legacy-data/area_codes.json
